# makepkg user overrides                                    {{/* chezmoi template */}}
#
# Path matters: makepkg sources ${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf
# (see source_makepkg_config() in /usr/share/makepkg/util/config.sh). A file at
# ~/.config/makepkg.conf is never read.
#
# Generated by chezmoi for {{ .chezmoi.hostname }} ({{ .chezmoi.os }}/{{ .chezmoi.arch }}).

# --- parallelism -------------------------------------------------------------
# /etc/makepkg.conf ships MAKEFLAGS commented out, which leaves make serial.
# Job count is resolved at build time, not at chezmoi apply time, so a machine
# that gains cores or RAM picks it up without a re-apply.
#
# Capped by memory as well as cores: a parallel C++ link can hold ~2G per job,
# and with BUILDDIR on tmpfs the build tree competes for the same RAM. Cores
# are usually the binding constraint; memory only wins on small-RAM boxes.
_jobs=$(nproc)
_memcap=$(( $(awk '/MemTotal/ {print $2}' /proc/meminfo) / 2097152 ))
(( _memcap < 1 )) && _memcap=1
(( _jobs > _memcap )) && _jobs=$_memcap
MAKEFLAGS="-j${_jobs}"
unset _jobs _memcap

# --- compiler cache ----------------------------------------------------------
{{- if lookPath "ccache" }}
# ccache is installed here. Worth having mainly for -git packages, where each
# rebuild recompiles a tree that has barely changed since the last one.
# NOTE: makepkg hard-errors if 'ccache' is in BUILDENV and the binary is absent
# (executable_ccache() in /usr/share/makepkg/executable/ccache.sh), which is why
# this is templated rather than set unconditionally.
BUILDENV=(!distcc color ccache check !sign)
{{- else }}
# ccache not installed on this host; leaving BUILDENV at the system default.
# makepkg would fail every build if 'ccache' were listed here without it.
{{- end }}

# --- build directory ---------------------------------------------------------
{{- $tmpfs := output "sh" "-c" "findmnt -no FSTYPE --target /tmp 2>/dev/null || true" | trim }}
{{- $tmpsize := atoi (output "sh" "-c" "findmnt -nbo SIZE --target /tmp 2>/dev/null || echo 0" | trim) }}
{{- if and (eq $tmpfs "tmpfs") (gt $tmpsize 21474836480) }}
# /tmp is tmpfs, {{ div $tmpsize 1073741824 }}G here, so build in RAM.
# Comment out for a build big enough to exhaust it (chromium and friends).
BUILDDIR=/tmp/makepkg
{{- else }}
# /tmp is {{ if eq $tmpfs "tmpfs" }}tmpfs but only {{ div $tmpsize 1073741824 }}G{{ else }}{{ $tmpfs | default "not a separate mount" }}{{ end }}
# on this host, so BUILDDIR is left at the system default (build in the source dir).
{{- end }}

# --- LTO ---------------------------------------------------------------------
# Deliberately not enabled. Arch ships !lto in /etc/makepkg.conf and opts in
# per-package where it has been tested; a global override applies it to AUR
# PKGBUILDs that never were. It also adds link time to every build and defers
# codegen to a stage ccache does not cache, which works against everything above.
# For a specific package where the runtime win is worth it, add options=(lto)
# to that PKGBUILD instead.
