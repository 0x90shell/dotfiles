#!/bin/bash
# emucloser — close running emulators/media apps via gamepad hotkey
# Called by evsieve-gamepad (Select + L1). Needs two presses within
# CONFIRM_WINDOW seconds. Deliberately SHORTER than RetroArch's 3s
# QUIT_DELAY_USEC: confirming here must imply RA also confirmed, or the
# escalation below could kill a game RA is still happily running.
export DISPLAY=:0
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

CONFIRM_WINDOW=${EMUCLOSER_WINDOW:-2}
STATE="${XDG_RUNTIME_DIR:-/tmp}/emucloser.armed"

toast() {  # msg [urgency] [ms]
  notify-send -u "${2:-normal}" -t "${3:-2500}" \
    -i dialog-information "emucloser" "$1" 2>/dev/null || true
}

# close_app <label> <process> [exe-path-match]
# Ask each of the process's windows to close, then escalate on the PID.
# Looks windows up by --pid so no window-class guessing is needed; if the
# app exposes no window the escalation still runs.
# exe-path-match is for AppImage-style apps whose comm is a generic
# launcher name: DuckStation runs as "AppRun", which every other AppImage
# is also called, so the pid is confirmed via /proc/PID/exe before use.
close_app() {
  local label="$1" proc="$2" needle="${3:-}" pid="" p target wid wins=0
  # The kernel caps comm at 15 chars and pgrep -x matches against that, so a
  # longer binary name (jellyfin-desktop) never matches unless trimmed first.
  proc="${proc:0:15}"
  for p in $(pgrep -x "$proc" 2>/dev/null); do
    if [[ -n "$needle" ]]; then
      target=$(readlink -f "/proc/$p/exe" 2>/dev/null) || continue
      [[ "$target" == *"$needle"* ]] || continue
    fi
    pid="$p"
    break
  done
  [[ -z "$pid" ]] && return 0
  while read -r wid; do
    [[ -z "$wid" ]] && continue
    xdotool windowquit "$wid" 2>/dev/null && wins=$((wins + 1))
  done < <(xdotool search --pid "$pid" 2>/dev/null)
  # Escalate only if the polite close did not take. Each step re-checks the
  # pid, so an app that exited cleanly is never signalled.
  {
    sleep 5
    kill -0 "$pid" 2>/dev/null || exit 0
    kill -15 "$pid" 2>/dev/null
    sleep 3
    kill -0 "$pid" 2>/dev/null || exit 0
    kill -9 "$pid" 2>/dev/null
    toast "$label force-killed (-9)" critical 4000
  } &
  echo "emucloser: closing $label (pid $pid, windows=$wins)"
}

# State lives on disk because evsieve runs this script fresh on each press.
now=$(date +%s)
armed_at=0
[[ -f "$STATE" ]] && armed_at=$(<"$STATE")
[[ "$armed_at" =~ ^[0-9]+$ ]] || armed_at=0

if (( now - armed_at > CONFIRM_WINDOW )); then
  echo "$now" > "$STATE"
  # RA shows its own "Press again to quit..." OSD; don't double up.
  pgrep -x retroarch >/dev/null || toast "Press again to quit..." low 3000
  echo "emucloser: armed"
  exit 0
fi

rm -f "$STATE"
echo "emucloser: confirmed, running"

# Cemu
if xdotool search --classname 'Cemu' search --name 'Cemu ' windowquit 2>/dev/null; then
  pkill -15 cemu 2>/dev/null
  { sleep 2; pkill -9 cemu 2>/dev/null; } &
  echo "emucloser: closed Cemu"
fi

# simple64
if xdotool search --class 'simple64-gui' windowquit 2>/dev/null; then
  { sleep 2; pkill -9 simple64-gui 2>/dev/null; } &
  echo "emucloser: closed simple64"
fi

# Kodi
if xdotool search --class 'Kodi' windowquit 2>/dev/null; then
  pkill -15 kodi.bin 2>/dev/null
  { sleep 2; pkill -9 kodi.bin 2>/dev/null; } &
  echo "emucloser: closed Kodi"
fi

# Jellyfin Media Player. Reinstalled as jellyfin-desktop, so the old
# --class 'jellyfin' match no longer applies.
close_app "Jellyfin" jellyfin-desktop

# VacuumTube
if xdotool search --class 'vacuumtube' windowquit 2>/dev/null; then
  pkill -15 vacuumtube 2>/dev/null
  echo "emucloser: closed VacuumTube"
fi

# Standalone emulators ES-DE launches. Kodi/Cemu/simple64 above keep their
# bespoke class-based matching; these use the PID helper.
close_app "Dolphin"     dolphin-emu
close_app "DuckStation" AppRun duckstation
close_app "Mednafen"    mednafen
close_app "melonDS"     melonDS
close_app "DeSmuME"     desmume
close_app "ares"        ares

# RetroArch. This same combo is RA's own quit, so give it time to save and exit
# on its own; only escalate if it survives. The ScummVM core can deadlock in
# retro_unload_game, which blocks RA's main loop so the first SIGTERM's quit
# flag is never polled — a second signal takes the force-exit path.
if pgrep -x retroarch >/dev/null; then
  {
    sleep 5
    pgrep -x retroarch >/dev/null || exit 0
    pkill -15 -x retroarch; sleep 2
    pgrep -x retroarch >/dev/null || exit 0
    pkill -15 -x retroarch; sleep 2
    if pgrep -x retroarch >/dev/null; then
      pkill -9 -x retroarch
      toast "RetroArch force-killed (-9)" critical 4000
    fi
  } &
  echo "emucloser: retroarch escalation armed"
fi

# ScummVM (standalone). Core-launched games run inside RetroArch and are handled
# above; this matches only the standalone build. windowquit alone closes the
# launcher — escalation covers a fullscreen game that may not respond as readily.
if xdotool search --class 'scummvm' windowquit 2>/dev/null; then
  { sleep 2; pkill -15 scummvm 2>/dev/null; sleep 2; pkill -9 scummvm 2>/dev/null; } &
  echo "emucloser: closed ScummVM"
fi

echo "emucloser: done"
exit 0
