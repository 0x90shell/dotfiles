#!/bin/bash
set -euo pipefail

# yayup — full system upgrade, then rebuild anything the upgrade broke.
#
# A soname/symbol-version bump leaves the dependency graph unchanged, so pacman
# sees nothing; only ldd does. checkrebuild reports ~15 permanent false
# positives here, so the signal is the diff against the previous run.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yayup"
BASELINE="$STATE_DIR/checkrebuild.baseline"
IGNORE="${XDG_CONFIG_HOME:-$HOME/.config}/yayup/ignore"
MIRROR_COUNTRY="${YAYUP_MIRROR_COUNTRY:-United States}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<EOF
usage: yayup [yay args...]

Refresh mirrors, upgrade everything (repo + AUR + devel), then rebuild any AUR
package the upgrade left linked against a library that moved.

Any arguments are passed through to \`yay -Syu\`.

Options:
  --rebuild-only    Skip the upgrade, just rebuild what is newly broken.
  --no-rebuild      Upgrade only, skip the rebuild check.
  --reset-baseline  Re-record what is currently broken as the new normal.

Files:
  $BASELINE
  $IGNORE

Environment:
  YAYUP_MIRROR_COUNTRY   reflector country (default: United States)
EOF
    exit 0
fi

do_upgrade=1
do_rebuild=1
case "${1:-}" in
    --rebuild-only)   do_upgrade=0; shift ;;
    --no-rebuild)     do_rebuild=0; shift ;;
    --reset-baseline) do_upgrade=0; do_rebuild=0; reset_baseline=1; shift ;;
esac

# Packages checkrebuild flags, minus the ignore list.
broken_now() {
    # </dev/null forces a full scan; checkrebuild otherwise reads a scoped
    # target list from stdin, which cannot be diffed against the baseline.
    checkrebuild </dev/null 2>/dev/null | awk '{print $NF}' | sort -u \
      | { if [[ -s "$IGNORE" ]]; then
              grep -vxFf <(grep -vE '^[[:space:]]*(#|$)' "$IGNORE") || true
          else cat; fi; } \
      | grep -v '^[[:space:]]*$' || true
}

# Returns 1 if anything is still broken afterwards.
rebuild_broken() {
    command -v checkrebuild >/dev/null || return 0

    local cur; cur="$(mktemp)"
    broken_now > "$cur"

    if [[ ! -f "$BASELINE" ]]; then
        install -Dm644 "$cur" "$BASELINE"; rm -f "$cur"
        echo "==> checkrebuild baseline recorded ($(wc -l < "$BASELINE") already flagged)"
        return 0
    fi

    local -a newly
    mapfile -t newly < <(comm -13 "$BASELINE" "$cur")
    if (( ${#newly[@]} == 0 )); then
        install -Dm644 "$cur" "$BASELINE"; rm -f "$cur"
        return 0
    fi
    rm -f "$cur"

    echo
    echo "==> Newly broken by this upgrade: ${newly[*]}"
    # Not fatal: the recheck below decides success, not yay's exit status.
    yay -S --rebuild --noconfirm "${newly[@]}" || true

    # A package can install cleanly and still link something that moved.
    local still; still="$(mktemp)"
    broken_now > "$still"

    local -a failed
    mapfile -t failed < <(comm -12 <(printf '%s\n' "${newly[@]}" | sort -u) "$still")

    if (( ${#failed[@]} )); then
        # Keep failures out of the baseline so they are reported again.
        comm -23 "$still" <(printf '%s\n' "${failed[@]}" | sort -u) > "$BASELINE"
        rm -f "$still"
        echo "==> STILL BROKEN after rebuild: ${failed[*]}" >&2
        echo "    fix these, or add them to $IGNORE" >&2
        return 1
    fi

    install -Dm644 "$still" "$BASELINE"; rm -f "$still"
    echo "==> Rebuilt OK: ${newly[*]}"
}

if [[ -n "${reset_baseline:-}" ]]; then
    mkdir -p "$STATE_DIR"
    broken_now > "$BASELINE"
    echo "==> Baseline reset: $(wc -l < "$BASELINE") package(s) recorded as normal"
    exit 0
fi

if (( do_upgrade )); then
    echo "==> Refreshing mirrorlist..."
    sudo reflector --country "$MIRROR_COUNTRY" --latest 5 --age 2 --fastest 5 \
        --protocol https --sort rate --save /etc/pacman.d/mirrorlist

    echo "==> Upgrading..."
    sudo pacman -Sy
    yay -Syu --devel "$@"
    yay -Y --devel --gendb
fi

(( do_rebuild )) && rebuild_broken
